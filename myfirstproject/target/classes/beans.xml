<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd
    http://www.springframework.org/schema/context http://www.springframework.org/schema/context/spring-context.xsd">
    
    
    
    <bean name="customer" class="com.aaslin.spring.myfirstproject.Customer">
    <property name="name" value="Aditya"/>
    <property name="id" value="aa1"/>
    </bean>
    
    <bean name="order" class ="com.aaslin.spring.myfirstproject.Order">
    <property name="order_id" value="o10"/>
    <property name="order_name" value="mobile"/>
    <property name="customer" ref="customer"/>
    
    </bean>
    
    
    </beans>